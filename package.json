{
  "name": "run-blog-next",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "check:prisma-client": "sh -c 'set -a; . ./.env.local; set +a; prisma generate && prisma validate'",
    "db:generate": "prisma generate",
    "db:push": "sh -c 'set -a; . ./.env.local; set +a; prisma db push'",
    "db:push:prod": "sh -c 'set -a; . ./.env.prod; set +a; prisma db push'"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.2.6",
    "@prisma/client": "^6.18.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/postcss": "^4.1.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.525.0",
    "motion": "^11.18.2",
    "next": "^16.2.6",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "prisma": "^6.18.0",
    "react-test-renderer": "^19.2.5",
    "typescript": "6.0.3",
    "vitest": "^3.2.0"
  }
}
