generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Run {
  id               String   @id @default(cuid())
  stravaId         BigInt   @unique
  name             String
  sportType        String?
  startDate        DateTime
  distanceKm       Float
  elapsedTimeMin   Float
  averageSpeedKmph Float?
  paceMinPerKm     Float?
  pace             String?
  description      String?
  splits           Json
  raw              Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("Runs")
}

model TimelineData {
  id              String   @id @default(cuid())
  year            Int
  month           Int
  totalRuns       Int
  totalDistanceKm Float
  topRuns         Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([year, month])
  @@index([year])
  @@map("TimelineData")
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime
  updatedAt    DateTime @updatedAt
  source       String?

  @@map("NewsletterSubscribers")
}
