generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model BlogGuitarRun {
  runId        String   @id @map("run_id") @db.Uuid
  version      String
  score        Int      @db.SmallInt
  total        Int      @default(5) @db.SmallInt
  answers      Json
  percentile   Int?     @db.SmallInt
  previousRuns Int      @map("previous_runs")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([version, score], map: "blog_guitar_leaderboard_version_score_idx")
  @@map("blog_guitar_leaderboard")
}

model BlogGuitarSong {
  id            String   @id
  title         String
  artist        String
  arrangementId String?  @map("arrangement_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  listEntries   BlogGuitarSongList[]

  @@map("blog_guitar_songs")
}

model BlogGuitarSongList {
  listId   String @map("list_id")
  position Int    @db.SmallInt
  songId   String @map("song_id")
  song     BlogGuitarSong @relation(fields: [songId], references: [id])

  @@id([listId, position])
  @@unique([listId, songId])
  @@map("blog_guitar_song_list")
}

model Run {
  id               String   @id @default(cuid())
  stravaId         BigInt   @unique
  name             String
  sportType        String?
  startDate        DateTime
  distanceKm       Float
  elapsedTimeMin   Float
  averageSpeedKmph Float?
  paceMinPerKm     Float?
  pace             String?
  description      String?
  splits           Json
  raw              Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("Runs")
}

model TimelineData {
  id              String   @id @default(cuid())
  year            Int
  month           Int
  totalRuns       Int
  totalDistanceKm Float
  topRuns         Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([year, month])
  @@index([year])
  @@map("TimelineData")
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime
  updatedAt    DateTime @updatedAt
  source       String?

  @@map("NewsletterSubscribers")
}

model BlogPostView {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("BlogPostViews")
}
